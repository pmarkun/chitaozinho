{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:3000} {
	log {
		format json
	}

	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	}

	@html path / /index.html /validar /metodologia /privacidade
	header @html Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://api.evidencias.org.br; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"

	@serviceWorker path /sw.js
	header @serviceWorker Cache-Control "no-cache, no-store, must-revalidate"

	@legacyRoutes {
		host evidencias.org.br www.evidencias.org.br
		path /validar* /metodologia*
	}
	redir @legacyRoutes https://beta.evidencias.org.br{uri} 308

	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
