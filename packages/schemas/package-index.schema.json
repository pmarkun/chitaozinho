{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chitaozinho.dev/schemas/0.1.0/package-index.schema.json",
  "title": "Chitaozinho package index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "created_at", "members"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "media_type", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
