#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import json
import os
import sys
import uuid
from datetime import UTC, datetime, timedelta
from hashlib import sha256
from pathlib import Path
from typing import Any
from urllib.parse import urlsplit

import boto3
from botocore.exceptions import ClientError

ARTIFACTS = {
    "capture-manifest.json": b'{"synthetic":true,"type":"manifest"}\n',
    "capture-manifest.server.sig": b"synthetic-signature\n",
    "chain/receipts.jsonl": b'{"synthetic":true,"type":"receipt"}\n',
    "proofs/attestation.json": b'{"synthetic":true,"type":"proof"}\n',
    "reports/verification.html": b"<!doctype html><title>Synthetic report</title>\n",
}


def require_environment(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise RuntimeError(f"{name} is required")
    return value


def client_error_code(error: ClientError) -> str:
    return str(error.response.get("Error", {}).get("Code", ""))


def validate_ceph_endpoint(value: str) -> str:
    parsed = urlsplit(value)
    if (
        parsed.scheme != "https"
        or parsed.hostname is None
        or parsed.username is not None
        or parsed.password is not None
        or parsed.path not in {"", "/"}
        or parsed.query
        or parsed.fragment
    ):
        raise ValueError("Ceph RGW endpoint must be an HTTPS origin")
    return value.rstrip("/")


def encode_report(report: dict[str, Any]) -> bytes:
    return json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True).encode() + b"\n"


def create_report(path: Path, report: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as output:
        output.write(encode_report(report))
        output.flush()
        os.fsync(output.fileno())


def replace_report(path: Path, report: dict[str, Any]) -> bytes:
    encoded = encode_report(report)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
        with os.fdopen(descriptor, "wb") as output:
            output.write(encoded)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
    return encoded


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Create retained synthetic evidence in an isolated Ceph RGW Object Lock "
            "test bucket and verify overwrite/delete refusal."
        )
    )
    parser.add_argument("--output", type=Path, required=True)
    arguments = parser.parse_args()

    if os.environ.get("CHITAOZINHO_RUN_OBJECT_LOCK_TEST") != "I_ACCEPT_24H_RETENTION":
        raise RuntimeError(
            "set CHITAOZINHO_RUN_OBJECT_LOCK_TEST=I_ACCEPT_24H_RETENTION "
            "after explicitly authorizing the irreversible test"
        )

    bucket = require_environment("CHITAOZINHO_S3_BUCKET")
    region = require_environment("CHITAOZINHO_S3_REGION")
    kms_key_id = require_environment("CHITAOZINHO_S3_KMS_KEY_ID")
    endpoint = validate_ceph_endpoint(require_environment("CHITAOZINHO_S3_ENDPOINT_URL"))
    access_key = require_environment("CHITAOZINHO_S3_ACCESS_KEY_ID")
    secret_key = require_environment("CHITAOZINHO_S3_SECRET_ACCESS_KEY")
    ca_bundle = os.environ.get("CHITAOZINHO_S3_CA_BUNDLE")
    if os.environ.get("CHITAOZINHO_STORAGE_PROVIDER") != "ceph":
        raise RuntimeError("the acceptance storage provider must be ceph")
    if region != "ceph":
        raise RuntimeError("the acceptance bucket must use the Ceph RGW region")

    client = boto3.client(
        "s3",
        endpoint_url=endpoint,
        region_name=region,
        aws_access_key_id=access_key,
        aws_secret_access_key=secret_key,
        verify=ca_bundle or True,
    )
    versioning = client.get_bucket_versioning(Bucket=bucket)
    if versioning.get("Status") != "Enabled":
        raise RuntimeError("bucket versioning is not enabled")
    lock = client.get_object_lock_configuration(Bucket=bucket).get("ObjectLockConfiguration", {})
    default_retention = lock.get("Rule", {}).get("DefaultRetention", {})
    if (
        lock.get("ObjectLockEnabled") != "Enabled"
        or default_retention.get("Mode") != "COMPLIANCE"
        or default_retention.get("Days") != 1
    ):
        raise RuntimeError("bucket must have Object Lock enabled with one-day COMPLIANCE retention")

    run_id = uuid.uuid4().hex
    prefix = f"acceptance/{run_id}"
    retain_until = datetime.now(UTC) + timedelta(days=1, minutes=5)
    objects: list[dict[str, Any]] = []
    started_at = datetime.now(UTC).isoformat().replace("+00:00", "Z")
    base_report: dict[str, Any] = {
        "schema_version": "0.1.0",
        "status": "started",
        "started_at": started_at,
        "bucket": bucket,
        "endpoint": endpoint,
        "region": region,
        "prefix": prefix,
        "sse_kms_key_id": kms_key_id,
        "synthetic_only": True,
        "planned_objects": sorted(ARTIFACTS),
        "objects": objects,
        "cleanup": (
            "Any uploaded object intentionally remains locked until retain_until; "
            "remove it only after retention expires."
        ),
    }
    create_report(arguments.output, base_report)
    print(f"report={arguments.output}", flush=True)
    print(f"run_prefix={prefix}", flush=True)

    for name, content in ARTIFACTS.items():
        key = f"{prefix}/{name}"
        digest = sha256(content).digest()
        response = client.put_object(
            Bucket=bucket,
            Key=key,
            Body=content,
            ContentLength=len(content),
            ChecksumSHA256=base64.b64encode(digest).decode("ascii"),
            Metadata={"sha256": f"sha256:{digest.hex()}", "synthetic": "true"},
            ObjectLockMode="COMPLIANCE",
            ObjectLockRetainUntilDate=retain_until,
            ServerSideEncryption="aws:kms",
            SSEKMSKeyId=kms_key_id,
            IfNoneMatch="*",
        )
        version_id = response.get("VersionId")
        if not version_id:
            raise RuntimeError(f"S3 returned no VersionId for {name}")
        head = client.head_object(Bucket=bucket, Key=key, VersionId=version_id)
        if (
            head.get("ObjectLockMode") != "COMPLIANCE"
            or head.get("ObjectLockRetainUntilDate") is None
            or head["ObjectLockRetainUntilDate"] < retain_until
            or head.get("ServerSideEncryption") != "aws:kms"
            or head.get("SSEKMSKeyId") != kms_key_id
            or head.get("Metadata", {}).get("sha256") != f"sha256:{digest.hex()}"
        ):
            raise RuntimeError(f"retention or encryption verification failed for {name}")
        objects.append(
            {
                "name": name,
                "key": key,
                "version_id": version_id,
                "sha256": f"sha256:{digest.hex()}",
                "retain_until": head["ObjectLockRetainUntilDate"]
                .astimezone(UTC)
                .isoformat()
                .replace("+00:00", "Z"),
            }
        )
        replace_report(
            arguments.output,
            {
                **base_report,
                "status": "retaining",
                "objects": objects,
            },
        )

    protected = objects[0]
    overwrite_refused = False
    try:
        client.put_object(
            Bucket=bucket,
            Key=protected["key"],
            Body=b"changed synthetic content",
            IfNoneMatch="*",
            ServerSideEncryption="aws:kms",
            SSEKMSKeyId=kms_key_id,
        )
    except ClientError as error:
        overwrite_refused = client_error_code(error) in {
            "PreconditionFailed",
            "412",
        }
    if not overwrite_refused:
        raise RuntimeError("conditional overwrite was not refused")

    delete_refused = False
    try:
        client.delete_object(
            Bucket=bucket,
            Key=protected["key"],
            VersionId=protected["version_id"],
        )
    except ClientError as error:
        delete_refused = client_error_code(error) in {"AccessDenied", "403"}
    if not delete_refused:
        raise RuntimeError("early deletion of the retained version was not refused")

    retention_reduction_refused = False
    try:
        client.put_object_retention(
            Bucket=bucket,
            Key=protected["key"],
            VersionId=protected["version_id"],
            Retention={
                "Mode": "COMPLIANCE",
                "RetainUntilDate": datetime.now(UTC) + timedelta(minutes=5),
            },
        )
    except ClientError as error:
        retention_reduction_refused = client_error_code(error) in {
            "AccessDenied",
            "InvalidRequest",
            "403",
        }
    if not retention_reduction_refused:
        raise RuntimeError("reduction of COMPLIANCE retention was not refused")

    preserved = client.head_object(
        Bucket=bucket,
        Key=protected["key"],
        VersionId=protected["version_id"],
    )
    if preserved.get("ObjectLockMode") != "COMPLIANCE":
        raise RuntimeError("protected version was not preserved after negative tests")

    report = {
        **base_report,
        "status": "complete",
        "tested_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
        "versioning": "Enabled",
        "object_lock": {
            "mode": "COMPLIANCE",
            "default_retention_days": 1,
        },
        "objects": objects,
        "overwrite_refused": overwrite_refused,
        "early_version_delete_refused": delete_refused,
        "retention_reduction_refused": retention_reduction_refused,
    }
    encoded = replace_report(arguments.output, report)
    print(f"report_sha256=sha256:{sha256(encoded).hexdigest()}")
    print(f"retained_objects={len(objects)}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:
        print(f"Object Lock acceptance failed: {error}", file=sys.stderr)
        sys.exit(1)
