#!/usr/bin/env bash
set -euo pipefail

phase="${1:-}"
duration="${2:-}"
output="${3:-}"

if [[ ! "${phase}" =~ ^[a-z0-9_-]+$ ]]; then
  echo "usage: $0 <phase> <seconds> <output.csv>" >&2
  exit 2
fi
if [[ ! "${duration}" =~ ^[1-9][0-9]*$ ]]; then
  echo "seconds must be a positive integer" >&2
  exit 2
fi
if [[ -z "${output}" ]]; then
  echo "output path is required" >&2
  exit 2
fi

clock_ticks="$(getconf CLK_TCK)"
if [[ ! -s "${output}" ]]; then
  printf 'timestamp,phase,chrome_processes,cpu_percent,rss_mib,read_mib,write_mib\n' \
    >"${output}"
fi

declare -A previous_cpu_by_pid=()
declare -A previous_read_by_pid=()
declare -A previous_write_by_pid=()
processes=0
rss=0
cpu_delta=0
read_delta=0
write_delta=0

sample_processes() {
  local pid cpu_value rss_value read_value write_value
  local -A seen=()
  processes=0
  rss=0
  cpu_delta=0
  while read -r pid; do
    [[ -r "/proc/${pid}/stat" ]] || continue
    cpu_value="$(
      awk '{print $14 + $15}' "/proc/${pid}/stat" 2>/dev/null || true
    )"
    [[ -n "${cpu_value}" ]] || continue
    rss_value="$(
      awk '/^VmRSS:/ {print $2}' "/proc/${pid}/status" 2>/dev/null || true
    )"
    read_value="$(
      awk '/^read_bytes:/ {print $2}' "/proc/${pid}/io" 2>/dev/null || true
    )"
    write_value="$(
      awk '/^write_bytes:/ {print $2}' "/proc/${pid}/io" 2>/dev/null || true
    )"
    seen["${pid}"]=1
    if [[ -v "previous_cpu_by_pid[${pid}]" ]] &&
      ((cpu_value >= previous_cpu_by_pid["${pid}"])); then
      cpu_delta=$((cpu_delta + cpu_value - previous_cpu_by_pid["${pid}"]))
    fi
    if [[ -v "previous_read_by_pid[${pid}]" ]] &&
      ((read_value >= previous_read_by_pid["${pid}"])); then
      read_delta=$((read_delta + read_value - previous_read_by_pid["${pid}"]))
    fi
    if [[ -v "previous_write_by_pid[${pid}]" ]] &&
      ((write_value >= previous_write_by_pid["${pid}"])); then
      write_delta=$((write_delta + write_value - previous_write_by_pid["${pid}"]))
    fi
    previous_cpu_by_pid["${pid}"]="${cpu_value}"
    previous_read_by_pid["${pid}"]="${read_value}"
    previous_write_by_pid["${pid}"]="${write_value}"
    rss=$((rss + ${rss_value:-0}))
    processes=$((processes + 1))
  done < <(ps -eo pid=,comm= | awk '$2 == "chrome" {print $1}')
  for pid in "${!previous_cpu_by_pid[@]}"; do
    if [[ ! -v "seen[${pid}]" ]]; then
      unset \
        "previous_cpu_by_pid[${pid}]" \
        "previous_read_by_pid[${pid}]" \
        "previous_write_by_pid[${pid}]"
    fi
  done
}

sample_processes
previous_time="$(date +%s%N)"

for ((sample = 1; sample <= duration; sample++)); do
  sleep 1
  current_time="$(date +%s%N)"
  sample_processes
  elapsed_ns=$((current_time - previous_time))
  cpu_percent="$(
    awk -v delta="${cpu_delta}" -v ticks="${clock_ticks}" -v ns="${elapsed_ns}" \
      'BEGIN { printf "%.2f", 100 * delta / ticks / (ns / 1000000000) }'
  )"
  rss_mib="$(awk -v kib="${rss}" 'BEGIN { printf "%.2f", kib / 1024 }')"
  read_mib="$(awk -v bytes="${read_delta}" 'BEGIN { printf "%.2f", bytes / 1048576 }')"
  write_mib="$(awk -v bytes="${write_delta}" 'BEGIN { printf "%.2f", bytes / 1048576 }')"
  printf '%s,%s,%s,%s,%s,%s,%s\n' \
    "$(date --iso-8601=seconds)" \
    "${phase}" \
    "${processes}" \
    "${cpu_percent}" \
    "${rss_mib}" \
    "${read_mib}" \
    "${write_mib}" >>"${output}"
  previous_time="${current_time}"
done

awk -F, -v phase="${phase}" '
  NR > 1 && $2 == phase {
    count += 1
    cpu += $4
    if ($5 > max_rss) max_rss = $5
    final_read = $6
    final_write = $7
  }
  END {
    if (count == 0) exit 1
    printf "phase=%s samples=%d avg_cpu_percent=%.2f max_rss_mib=%.2f read_mib=%.2f write_mib=%.2f\n",
      phase, count, cpu / count, max_rss, final_read, final_write
  }
' "${output}"
