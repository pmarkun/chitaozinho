#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
first_target="$(mktemp -d)"
second_target="$(mktemp -d)"
trap 'rm -rf "$first_target" "$second_target"' EXIT

export CARGO_INCREMENTAL=0
export SOURCE_DATE_EPOCH
SOURCE_DATE_EPOCH="$(git -C "$project_root" log -1 --format=%ct)"
export RUSTFLAGS="--remap-path-prefix=${project_root}=/src -C strip=symbols"

build() {
  local target="$1"
  CARGO_TARGET_DIR="$target" cargo build \
    --manifest-path "${project_root}/Cargo.toml" \
    --locked \
    --release \
    --bin chitaozinho-verify
}

build "$first_target"
build "$second_target"

first_hash="$(sha256sum "${first_target}/release/chitaozinho-verify" | cut -d' ' -f1)"
second_hash="$(sha256sum "${second_target}/release/chitaozinho-verify" | cut -d' ' -f1)"

if [[ "$first_hash" != "$second_hash" ]]; then
  echo "Verifier builds differ: ${first_hash} != ${second_hash}" >&2
  exit 1
fi

echo "Verifier reproducible SHA-256: ${first_hash}"
