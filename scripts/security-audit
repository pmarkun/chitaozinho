#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temporary="$(mktemp -d)"
trap 'rm -rf "${temporary}"' EXIT
source_tree="${temporary}/source"
osv_report="${temporary}/osv.json"
mkdir "${source_tree}"

(
  cd "${project_root}"
  git ls-files -z |
    tar --null --files-from=- --create --format=posix
) | tar --extract --directory="${source_tree}"

set +e
osv-scanner scan source \
  --recursive \
  --include-git-root \
  --call-analysis=rust \
  --format json \
  --output "${osv_report}" \
  "${source_tree}"
osv_status=$?
set -e

if [[ "${osv_status}" -gt 1 || ! -s "${osv_report}" ]]; then
  echo "OSV Scanner failed with status ${osv_status}" >&2
  exit "${osv_status}"
fi

unaccepted_vulnerabilities="$(
  jq '
    [
      .results[]?.packages[]? as $finding
      | $finding.vulnerabilities[]?
      | {
          package: $finding.package,
          vulnerability: {
            id: .id,
            summary: .summary
          }
        }
    ]
  ' "${osv_report}"
)"

if [[ "$(jq 'length' <<<"${unaccepted_vulnerabilities}")" -ne 0 ]]; then
  echo "OSV Scanner found unaccepted dependency vulnerabilities:" >&2
  jq . <<<"${unaccepted_vulnerabilities}" >&2
  exit 1
fi

trivy filesystem \
  --scanners misconfig,secret \
  --severity HIGH,CRITICAL \
  --exit-code 1 \
  --no-progress \
  --skip-dirs .git \
  "${source_tree}"

echo "Security audit passed: dependency vulnerabilities, secrets and misconfigurations"
