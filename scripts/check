#!/usr/bin/env bash
set -euo pipefail

actionlint

pnpm -r format
pnpm -r lint
pnpm -r typecheck
pnpm -r test
pnpm -r build
./scripts/check-extension-reproducibility

uv run ruff check .
uv run pytest

migration_db_path=$(mktemp --suffix=.db)
trap 'rm -f "$migration_db_path"' EXIT
CHITAOZINHO_DATABASE_URL="sqlite:///$migration_db_path" uv run alembic upgrade head
CHITAOZINHO_DATABASE_URL="sqlite:///$migration_db_path" uv run alembic check

cargo fmt --all --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace

tofu -chdir=infra/terraform fmt -check
tofu -chdir=infra/terraform init -backend=false -input=false -lockfile=readonly
tofu -chdir=infra/terraform validate
python -m json.tool infra/railway/api.json >/dev/null
python -m json.tool infra/railway/worker.json >/dev/null
