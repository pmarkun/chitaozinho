#!/usr/bin/env bash
set -euo pipefail

actionlint
python scripts/check-repository-hygiene.py

pnpm -r format
pnpm -r lint
pnpm -r typecheck
pnpm -r test
pnpm -r build
playwright test --config apps/extension/playwright.config.cjs
pnpm --filter @chitaozinho/verifier-web test:e2e
./scripts/check-extension-reproducibility

uv run ruff check .
uv run pytest

migration_db_path=$(mktemp --suffix=.db)
trap 'rm -f "$migration_db_path"' EXIT
CHITAOZINHO_DATABASE_URL="sqlite:///$migration_db_path" uv run alembic upgrade head
CHITAOZINHO_DATABASE_URL="sqlite:///$migration_db_path" uv run alembic check

cargo fmt --all --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace

python scripts/check-ceph-config.py
python scripts/check-openbao-config.py
python scripts/check-railway-config.py
python scripts/check-monitoring-config.py
