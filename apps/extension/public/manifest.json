{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "pt_BR",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://api-staging-db23.up.railway.app/*"
  ]
}
